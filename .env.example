# cers-index 환경 변수 템플릿
# 실제 값은 .env 에 복사하여 작성 (.gitignore 에 포함됨)

# Supabase PostgreSQL (CERsIndex-batch 와 동일 DB)
PGHOST=aws-1-ap-northeast-2.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.lqwerolxuszvepbtnnbd
PGPASSWORD=<비밀번호>
PGSSLMODE=require

# 커넥션 풀 (선택)
# PGPOOL_MAX=2
# PGPOOL_IDLE_TIMEOUT_MS=10000
# PGPOOL_CONNECTION_TIMEOUT_MS=10000

# 데이터 소스 강제 지정 (선택, 기본값: db)
# NEXT_PUBLIC_DATA_SOURCE=db   # db | fallback
